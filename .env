# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> app/chat-pipeline ###
GAME_API_TOKEN=
GAME_DAILY_PLAYER_QUOTA=120
GAME_MONTHLY_PLAYER_QUOTA=2000
GAME_DAILY_IP_QUOTA=300
# Ukupan dnevni plafon za ceo servis (~250 aktivnih igraca/dan na startu;
# podigni kad prodaja krene — plafonira najgori dnevni AI trosak).
GAME_GLOBAL_DAILY_QUOTA=5000
# Mail-worthy line: more chats in one UTC day than a normal run. The hard cap is still the quota.
GAME_ABUSE_WATCH_CHATS=40
# Comma-separated list of proxies to trust for X-Forwarded-For.
# On Render (single reverse proxy in front) use: 127.0.0.1,REMOTE_ADDR
# Required in production — /readyz fails closed when empty.
TRUSTED_PROXIES=
# Redis DSN used by the prod rate limiter storage (required when APP_ENV=prod).
# Example: redis://localhost:6379 or Render Key Value internal URL.
REDIS_URL=redis://localhost:6379
# Shared secret the monitor sends as X-Metrics-Token to read GET /metrics.
# Empty means the endpoint does not exist (404). openssl rand -hex 32.
METRICS_TOKEN=
# Steam auth: publisher Web API key + app id (https://partner.steamgames.com).
# Leave empty to disable /api/auth/steam (dev / non-Steam builds).
STEAM_WEB_API_KEY=
STEAM_APP_ID=
# Secret for signing short-lived session tokens (openssl rand -hex 32).
SESSION_TOKEN_SECRET=
SESSION_TOKEN_TTL=43200
# Allow legacy shared X-Game-Token auth. MUST be false on production Steam builds.
# Local/dev may set true; /readyz rejects AUTH_ALLOW_GAME_TOKEN=true when APP_ENV=prod.
AUTH_ALLOW_GAME_TOKEN=false
# Provider tiers are ordered per loop by ProviderRoutingPolicy: loops 1-3 try
# cheap first, loops 4+ try best first. The primary slot is the "best" tier and
# fallback2 is the "cheap" tier, so terra as primary and luna as fallback2 give
# luna the first three loops and terra everything after, with each covering the
# other when a reply comes back in a broken format.
AI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-5.6-terra
AI_SYSTEM_PROMPT=
AI_TLS_VERIFY=true
AI_FALLBACK_ENABLED=false
AI_FALLBACK_CHAT_COMPLETIONS_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_TLS_VERIFY=true
AI_FALLBACK2_ENABLED=true
AI_FALLBACK2_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
AI_FALLBACK2_API_KEY=
AI_FALLBACK2_MODEL=gpt-5.6-luna
AI_FALLBACK2_TLS_VERIFY=true
# Per-run commitment / controlled misdirection. Keep false until Steam QA closes
# and live probe of the accurate → misdirect → accusation → wrong-lift path passes.
AI_COMMITMENT_ENABLED=false
# Fail-closed input/output moderation. If the dedicated key is empty, the
# OpenAI fallback key is used.
AI_MODERATION_URL=https://api.openai.com/v1/moderations
AI_MODERATION_API_KEY=
AI_MODERATION_MODEL=omni-moderation-latest
AI_MODERATION_TIMEOUT_SECONDS=3
###< app/chat-pipeline ###
