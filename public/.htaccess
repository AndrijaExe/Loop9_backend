<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve files/directories directly when they exist.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Send everything else to Symfony front controller.
    RewriteRule ^ index.php [L]
</IfModule>
